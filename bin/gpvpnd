#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""gpvpnd — unprivileged-testable GlobalProtect tunnel daemon.

The marketplace build never calls sudo or pkexec. Root, when it is used at
all, is the systemd unit the user installed with tools/setup.sh. Tests pass
--socket and --openconnect and run this as the normal user.

The openconnect argument list is fixed. The prelogin cookie is written to
the child's stdin and is never placed on the command line or in a log line.
"""

from __future__ import annotations

import argparse
import fcntl
import json
import os
import re
import signal
import socket
import subprocess
import sys
import threading
import time

_COOKIE_SHAPED = re.compile(r"[A-Za-z0-9+/=]{40,}")
_GATEWAY_LINE = re.compile(r"^\s*(.+?)\s+\(([^)]+)\)\s+\[priority\s+(\d+)\]\s*$")
_GATEWAY_NAME = re.compile(r"^Gateway:\s*(.+?)\s*$")
_CONNECTED = re.compile(r"Connected as\s+([0-9A-Fa-f:.]+)")
_EXPIRES = re.compile(r"(?:will expire at|expires)\s+(\S+)")
_SERVERCERT_RE = re.compile(r"^[0-9A-Fa-f]{40}$")

OS_VALUES = frozenset({
    "win", "win7", "win8", "win8-1", "win10",
    "mac", "mac-intel", "linux", "linux-64",
    "android", "freebsd", "openbsd", "solaris",
})

FILE_KEYS = {"csdWrapper", "cafile", "certificate", "sslkey", "vpncScript"}
FILE_FLAGS = {
    "csdWrapper": "--csd-wrapper",
    "cafile": "--cafile",
    "certificate": "--certificate",
    "sslkey": "--sslkey",
    "vpncScript": "--script",
}

BUSY = {"auth", "connecting", "connected"}


def redact(text: str) -> str:
    return _COOKIE_SHAPED.sub("[redacted]", text or "")


def _plain_token(value: str, max_len: int = 512) -> bool:
    if not value or value.startswith("-"):
        return False
    return "\n" not in value and "\x00" not in value and len(value) <= max_len


def build_argv(
    binary: str,
    user: str,
    usergroup: str,
    server: str,
    options: dict | None = None,
    password_mode: bool = False,
) -> tuple[list[str], str | None]:
    """Build the openconnect argv from a whitelist of options.

    Returns (argv, error_message).  error_message is non-None when an option
    fails validation; in that case argv is the partial list built so far.
    """
    if not _plain_token(user) or not _plain_token(server):
        return [], "Refusing an unsafe connect field"

    # Validate options first so we can honour an ``os`` override and avoid
    # emitting the default ``--os linux-64`` alongside a user-supplied one.
    err = _validate_options(options, password_mode, usergroup)
    if err:
        return [], err

    os_value = options.get("os") if options else None  # type: ignore[union-attr]
    if not os_value:
        os_value = "linux-64"

    args = [binary, "--protocol=gp", "--user", user]

    if not password_mode:
        # Cookie mode: always include --usergroup
        if not _plain_token(usergroup):
            return [], "Refusing an unsafe connect field"
        if not usergroup or _COOKIE_SHAPED.search(usergroup):
            return [], "Refusing an unsafe connect field"
        args.extend([
            "--passwd-on-stdin", "--non-inter",
            "--useragent", "PAN GlobalProtect", "--os", os_value,
            "--usergroup", usergroup,
        ])
    else:
        # Password mode: only include --usergroup when explicitly provided and valid
        if usergroup and _plain_token(usergroup):
            args.extend([
                "--passwd-on-stdin", "--non-inter",
                "--useragent", "PAN GlobalProtect", "--os", os_value,
                "--usergroup", usergroup,
            ])
        else:
            args.extend([
                "--passwd-on-stdin", "--non-inter",
                "--useragent", "PAN GlobalProtect", "--os", os_value,
            ])

    # Append validated option flags (all before the positional server arg)
    if options:
        for key, value in options.items():
            if key == "os":
                continue  # already set as os_value above
            if key == "useragent":
                args.extend(["--useragent", value])
            elif key in FILE_KEYS:
                args.extend([FILE_FLAGS[key], value])
            elif key == "servercert":
                args.append(f"--servercert={value}")
            elif key == "baseMtu":
                args.append(f"--base-mtu={int(value)}")
            elif key == "noDtls" and value is True:
                args.append("--no-dtls")
            elif key == "reconnectTimeout":
                args.append(f"--reconnect-timeout={int(value)}")

    args.append(server)
    return args, None


def _validate_options(
    options: dict | None,
    password_mode: bool,
    usergroup: str,
) -> str | None:
    """Validate whitelist options against the connect request.

    Returns an error string on failure; ``None`` on success.
    Side effects: none — ``build_argv`` inserts validated values into argv.
    """
    if not options:
        return None

    for key, value in options.items():
        if key == "os":
            if value not in OS_VALUES:
                return f"Invalid os value: {value}"

        elif key == "useragent":
            if not _plain_token(value, 256):
                return f"Invalid useragent value"

        elif key in FILE_KEYS:
            flag = FILE_FLAGS[key]
            if not isinstance(value, str) or not value or not _plain_token(value):
                return f"Invalid {key} value"
            if not os.path.isabs(value):
                return f"{key} must be an absolute path"
            if not os.path.isfile(value):
                return f"{key} file does not exist"

        elif key == "servercert":
            if not isinstance(value, str) or not _SERVERCERT_RE.match(value):
                return f"Invalid servercert value"

        elif key == "baseMtu":
            try:
                v = int(value)
            except (ValueError, TypeError):
                return f"Invalid baseMtu value"
            if v < 576 or v > 65535:
                return f"baseMtu out of range"

        elif key == "noDtls":
            if value is True:
                pass  # handled by build_argv

        elif key == "reconnectTimeout":
            try:
                v = int(value)
            except (ValueError, TypeError):
                return f"Invalid reconnectTimeout value"
            if v < 10 or v > 86400:
                return f"reconnectTimeout out of range"

        else:
            return f"Unknown option: {key}"

    return None


class Daemon:
    def __init__(self, openconnect: str, state_file: str, verbose: bool) -> None:
        self.openconnect = openconnect
        self.state_file = state_file
        self.verbose = verbose
        self.lock = threading.Lock()
        self.clients: list[socket.socket] = []
        self.proc: subprocess.Popen[str] | None = None
        self.want_disconnect = False
        self.stopping = False
        self.server: socket.socket | None = None
        self.state = "idle"
        self.ip = ""
        self.gateway = ""
        self.user = ""
        self.expires = ""
        self.since = 0
        self.message = ""
        self.server_host = ""
        self.gateways: list[dict[str, object]] = []
        self.manual_gateway = ""
        self.last_line = ""
        # Traffic stats
        self.rx_bytes = 0
        self.tx_bytes = 0
        self.iface = ""
        self._stats_thread: threading.Thread | None = None
        self._load_state()

    def public(self) -> dict[str, object]:
        return {
            "state": self.state,
            "ip": self.ip,
            "gateway": self.gateway,
            "user": self.user,
            "expires": self.expires,
            "since": self.since,
            "message": self.message,
            "server": self.server_host,
            "gateways": self.gateways,
            "rxBytes": self.rx_bytes,
            "txBytes": self.tx_bytes,
            "iface": self.iface,
        }

    @staticmethod
    def netdev_stats(base: str, iface: str) -> tuple[int, int] | None:
        """Read rx/tx bytes for *iface* under *base*.

        Returns (rx_bytes, tx_bytes) or None when the interface data is
        unavailable.
        """
        try:
            rx_path = os.path.join(base, iface, "statistics", "rx_bytes")
            tx_path = os.path.join(base, iface, "statistics", "tx_bytes")
            with open(rx_path, encoding="utf-8") as fh:
                rx = int(fh.read().strip())
            with open(tx_path, encoding="utf-8") as fh:
                tx = int(fh.read().strip())
            return rx, tx
        except (OSError, ValueError):
            return None

    # ---- traffic stats --------------------------------------------------

    def _start_traffic_stats(self) -> None:
        with self.lock:
            initial = set()
            try:
                initial = set(os.listdir("/sys/class/net"))
            except OSError:
                pass
            self._stats_thread = threading.Thread(
                target=self._traffic_loop, args=(initial,), daemon=True
            )
            self._stats_thread.start()

    def _traffic_loop(self, initial: set[str]) -> None:
        while True:
            time.sleep(5)
            try:
                current = set(os.listdir("/sys/class/net"))
            except OSError:
                continue
            new = {n for n in current if n not in initial}
            if not new:
                continue
            # Prefer interfaces starting with "tun" or "gp"
            preferred = [n for n in new if n.startswith("tun") or n.startswith("gp")]
            iface = preferred[0] if preferred else sorted(new)[0]
            base = "/sys/class/net"
            while True:
                result = self.netdev_stats(base, iface)
                if result is not None:
                    rx, tx = result
                    with self.lock:
                        if self.state not in BUSY:
                            return
                        if self.rx_bytes != rx or self.tx_bytes != tx or self.iface != iface:
                            self.rx_bytes = rx
                            self.tx_bytes = tx
                            self.iface = iface
                            snap = dict(self.public())
                    self._broadcast({"type": "state", **snap})
                time.sleep(5)

    def _stop_traffic_stats(self) -> None:
        self._clear_traffic_stats()
        if self._stats_thread is not None:
            self._stats_thread.join(timeout=2)
            self._stats_thread = None

    def _clear_traffic_stats(self) -> None:
        self.rx_bytes = 0
        self.tx_bytes = 0
        self.iface = ""

    # ---------------------------------------------------------------------

    def _load_state(self) -> None:
        if not self.state_file or not os.path.isfile(self.state_file):
            return
        try:
            saved = json.loads(open(self.state_file, encoding="utf-8").read())
        except (OSError, json.JSONDecodeError):
            return
        # A previous summary is only a hint. No child is alive at startup,
        # so a saved "connected" must not paint a live tunnel.
        self.gateway = str(saved.get("gateway") or "")
        self.user = ""
        self.state = "idle"

    def _save_state(self) -> None:
        if not self.state_file:
            return
        blob = redact(json.dumps(self.public()))
        tmp = self.state_file + ".tmp"
        try:
            os.makedirs(os.path.dirname(self.state_file) or ".", exist_ok=True)
            with open(tmp, "w", encoding="utf-8") as handle:
                handle.write(blob)
                handle.write("\n")
            os.replace(tmp, self.state_file)
        except OSError:
            return

    def _broadcast(self, message: dict[str, object]) -> None:
        data = (json.dumps(message) + "\n").encode()
        with self.lock:
            clients = list(self.clients)
        dead: list[socket.socket] = []
        for client in clients:
            try:
                client.sendall(data)
            except OSError:
                dead.append(client)
        if dead:
            with self.lock:
                for client in dead:
                    if client in self.clients:
                        self.clients.remove(client)

    def _send(self, client: socket.socket, message: dict[str, object]) -> None:
        try:
            client.sendall((json.dumps(message) + "\n").encode())
        except OSError:
            pass

    def _enter(self, state: str, **fields: object) -> None:
        with self.lock:
            for key, value in fields.items():
                setattr(self, key, value)
            if state == "idle":
                self.ip = ""
                self.expires = ""
                self.server_host = ""
                self._clear_traffic_stats()
            self.state = state
            if state == "connected":
                self.since = int(time.time())
                self.message = ""
            snap = dict(self.public())
        if self.verbose:
            print(f"state {state}", file=sys.stderr)
        self._save_state()
        self._broadcast({"type": "state", **snap})

    def _kill(self, proc: subprocess.Popen[str] | None) -> None:
        if proc is None or proc.poll() is not None:
            return
        try:
            os.killpg(proc.pid, signal.SIGTERM)
        except (OSError, ProcessLookupError):
            try:
                proc.terminate()
            except OSError:
                return

    def dispatch(self, request: dict[str, object]) -> dict[str, object] | None:
        command = request.get("cmd")
        if command == "status":
            with self.lock:
                return {"type": "state", **self.public()}
        if command == "disconnect":
            return self.disconnect()
        if command == "connect":
            return self.start_connect(request)
        return {"type": "error", "message": "Unknown command"}

    def start_connect(self, request: dict[str, object]) -> dict[str, object]:
        cookie = str(request.get("cookie") or "")
        user = str(request.get("user") or "")
        server = str(request.get("server") or "")
        password = str(request.get("password") or "")
        usergroup = str(request.get("usergroup") or "")
        gateway = str(request.get("gateway") or "")
        options = request.get("options")
        if not isinstance(options, dict):
            options = None

        password_mode = bool(password) and _plain_token(password)

        # Validate non-password fields
        if not _plain_token(server) or not _plain_token(user):
            return {"type": "error", "message": "Refusing an unsafe connect field"}
        if password_mode:
            if usergroup and not _plain_token(usergroup):
                return {"type": "error", "message": "Refusing an unsafe connect field"}
        else:
            if not _plain_token(usergroup):
                return {"type": "error", "message": "Refusing an unsafe connect field"}
            if not cookie or _COOKIE_SHAPED.search(usergroup):
                return {"type": "error", "message": "Refusing an unsafe connect field"}

        # Validate options against whitelist
        args, err = build_argv(
            self.openconnect, user, usergroup, server,
            options=options, password_mode=password_mode,
        )
        if err:
            return {"type": "error", "message": err}

        with self.lock:
            if self.state in BUSY:
                return {"type": "error", "message": "Already connecting or connected"}
            self.want_disconnect = False
            self.user = user
            self.server_host = server
            self.manual_gateway = gateway
            self.gateway = gateway
            self.ip = ""
            self.expires = ""
            self.message = ""
            self.gateways = []
            self.last_line = ""
            self.state = "auth"
            self.since = int(time.time())
            snap = dict(self.public())
        self._save_state()
        self._broadcast({"type": "state", **snap})
        threading.Thread(
            target=self._run_tunnel,
            args=(args, password, cookie),
            daemon=True,
        ).start()
        return {"type": "accepted", **snap}

    def disconnect(self) -> dict[str, object]:
        with self.lock:
            self.want_disconnect = True
            proc = self.proc
            self.state = "idle"
            self.ip = ""
            self.expires = ""
            self.message = ""
            self.server_host = ""
            snap = dict(self.public())
        self._kill(proc)
        self._stop_traffic_stats()
        self._save_state()
        self._broadcast({"type": "state", **snap})
        return {"type": "accepted", **snap}

    def _run_tunnel(self, argv: list[str], password: str, cookie: str) -> None:
        try:
            proc = subprocess.Popen(
                argv,
                stdin=subprocess.PIPE,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                text=True,
            )
        except OSError:
            self._enter("failed", message="Could not start the tunnel")
            return
        with self.lock:
            if self.want_disconnect or self.stopping:
                self.proc = proc
                intentional = True
            else:
                self.proc = proc
                intentional = False
        try:
            if proc.stdin is not None:
                if password:
                    proc.stdin.write(password + "\n")
                else:
                    proc.stdin.write(cookie + "\n")
                proc.stdin.close()
        except OSError:
            pass
        # The cookie/password leaves scope here. They are not stored on the daemon.
        del cookie, password
        if intentional:
            self._kill(proc)
        else:
            self._enter("connecting")
            self._start_traffic_stats()
        assert proc.stdout is not None
        for line in proc.stdout:
            self._on_output(line.rstrip("\n"))
        proc.wait()
        with self.lock:
            self.proc = None
            intentional = self.want_disconnect
            self.want_disconnect = False
            current = self.state
        if intentional or self.stopping:
            if current != "idle":
                self._enter("idle")
            return
        if current == "connected":
            self._enter("dropped", message="Tunnel closed")
        else:
            self._enter("failed", message=self.last_line or "Connection failed")

    def _on_output(self, line: str) -> None:
        with self.lock:
            if self.want_disconnect or self.stopping:
                return
        redacted = redact(line)
        self.last_line = redacted
        self._broadcast({"type": "log", "line": redacted})
        gateway_line = _GATEWAY_LINE.match(line)
        if gateway_line:
            entry = {
                "name": gateway_line.group(1).strip(),
                "host": gateway_line.group(2).strip(),
                "priority": int(gateway_line.group(3)),
            }
            with self.lock:
                self.gateways.append(entry)
                if not self.manual_gateway:
                    self.gateway = str(entry["name"])
                current = self.state
                snap = dict(self.public())
            if current == "connected":
                self._broadcast({"type": "state", **snap})
            return
        named = _GATEWAY_NAME.match(line)
        if named:
            with self.lock:
                if not self.manual_gateway:
                    self.gateway = named.group(1).strip()
                current = self.state
                snap = dict(self.public())
            if current == "connected":
                self._broadcast({"type": "state", **snap})
            return
        expiry = _EXPIRES.search(line)
        if expiry:
            with self.lock:
                self.expires = expiry.group(1)
                current = self.state
                snap = dict(self.public())
            if current == "connected":
                self._broadcast({"type": "state", **snap})
            return
        connected = _CONNECTED.search(line)
        if connected:
            with self.lock:
                self.ip = connected.group(1)
                if not self.gateway:
                    self.gateway = self.server_host
            self._enter("connected")

    def _adopt_listen_fd(self) -> socket.socket | None:
        """Use the socket systemd already bound. Never unlink that path.

        gp-vpn.socket is mode 0660 and group wheel. Replacing it drops the
        client that caused activation and leaves a root-owned socket the bar
        user cannot open. LISTEN_PID must be this process, same as sd_listen_fds.
        """
        raw_pid = os.environ.get("LISTEN_PID")
        raw_count = os.environ.get("LISTEN_FDS")
        if not raw_pid or raw_pid != str(os.getpid()) or not raw_count:
            return None
        try:
            count = int(raw_count)
        except ValueError:
            return None
        if count < 1:
            return None
        for key in ("LISTEN_FDS", "LISTEN_PID", "LISTEN_FDNAMES"):
            os.environ.pop(key, None)
        fd = 3
        os.set_inheritable(fd, False)
        flags = fcntl.fcntl(fd, fcntl.F_GETFL)
        fcntl.fcntl(fd, fcntl.F_SETFL, flags & ~os.O_NONBLOCK)
        adopted = socket.socket(fileno=fd)
        adopted.set_inheritable(False)
        adopted.settimeout(0.5)
        return adopted

    def _live_socket(self, path: str) -> bool:
        """True when some process is already accepting on this path."""
        if not os.path.exists(path):
            return False
        probe = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        probe.settimeout(0.2)
        try:
            probe.connect(path)
        except OSError:
            return False
        finally:
            probe.close()
        return True

    def serve(self, path: str) -> None:
        adopted = self._adopt_listen_fd()
        if adopted is not None:
            server = adopted
        else:
            directory = os.path.dirname(path)
            if directory:
                os.makedirs(directory, exist_ok=True)
            if self._live_socket(path):
                print(f"gpvpnd: {path} is already being served", file=sys.stderr)
                raise SystemExit(1)
            # Hold the lock until this process exits, including a crash.
            # A second manual start then fails instead of unlinking the live socket.
            self._lock_fd = os.open(path + ".lock", os.O_CREAT | os.O_RDWR, 0o600)
            try:
                fcntl.flock(self._lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except OSError:
                print(f"gpvpnd: {path} is already being served", file=sys.stderr)
                raise SystemExit(1)
            if os.path.exists(path):
                os.unlink(path)
            server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            server.bind(path)
            os.chmod(path, 0o660)
            server.listen(8)
            server.settimeout(0.5)
        self.server = server

        def _stop(_signum: int, _frame: object) -> None:
            self.stopping = True
            self._kill(self.proc)
            try:
                server.close()
            except OSError:
                pass

        signal.signal(signal.SIGTERM, _stop)
        signal.signal(signal.SIGINT, _stop)
        while not self.stopping:
            try:
                conn, _addr = server.accept()
            except socket.timeout:
                continue
            except OSError:
                break
            threading.Thread(target=self._client, args=(conn,), daemon=True).start()

    def _client(self, conn: socket.socket) -> None:
        with self.lock:
            self.clients.append(conn)
        buffer = b""
        try:
            while not self.stopping:
                try:
                    chunk = conn.recv(65536)
                except OSError:
                    break
                if not chunk:
                    break
                buffer += chunk
                while b"\n" in buffer:
                    raw, buffer = buffer.split(b"\n", 1)
                    if not raw.strip():
                        continue
                    try:
                        request = json.loads(raw.decode("utf-8"))
                    except json.JSONDecodeError:
                        self._send(conn, {"type": "error", "message": "Bad request"})
                        continue
                    if not isinstance(request, dict):
                        self._send(conn, {"type": "error", "message": "Bad request"})
                        continue
                    reply = self.dispatch(request)
                    if reply is not None:
                        self._send(conn, reply)
        finally:
            with self.lock:
                if conn in self.clients:
                    self.clients.remove(conn)
            try:
                conn.close()
            except OSError:
                pass


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gpvpnd")
    parser.add_argument("--socket", default=os.environ.get("GPVPN_SOCKET") or "/run/gp-vpn/ctrl.sock")
    parser.add_argument("--openconnect", default="openconnect")
    parser.add_argument("--state-file", default="")
    parser.add_argument("-v", action="store_true")
    args = parser.parse_args(argv)
    Daemon(args.openconnect, args.state_file, args.v).serve(args.socket)
    return 0


if __name__ == "__main__":
    sys.exit(main())
