#!/usr/bin/env bash
# Stand-in for openconnect. Records argv and stdin, then prints a canned
# tunnel or fails. The cookie must arrive on stdin, never in argv.
set -u
dir=${FAKE_OC_DIR:?}
mkdir -p "$dir"
printf '%s\n' "---" "$@" >> "$dir/argv.log"
printf '%s\n' "$@" > "$dir/argv"
cat > "$dir/stdin"
ug=""
for arg in "$@"; do
  case "$arg" in
    gateway:*|portal:*) ug=$arg ;;
  esac
done
printf '%s\n' "$ug" >> "$dir/usergroup.log"
mode=${FAKE_OC_MODE:-ok}
# Every line below is what openconnect 9.21 really prints, stderr and stdout
# merged as the daemon reads them. Keep it that way: a line invented here hid
# a parser that could never see a real tunnel come up.
if [[ $mode == fail ]]; then
  echo "Login failed." >&2
  echo "Failed to complete authentication" >&2
  exit 1
fi
if [[ $mode == fail-gateway && $ug == gateway:* ]]; then
  echo "Login failed." >&2
  echo "Failed to complete authentication" >&2
  exit 1
fi
if [[ $mode == dns ]]; then
  echo "getaddrinfo failed for host 'nonexistent.invalid': Name or service not known" >&2
  echo "Failed to open HTTPS connection to nonexistent.invalid" >&2
  echo "Failed to complete authentication" >&2
  exit 1
fi
# A portal with several gateways cannot prompt under --non-inter.
if [[ $mode == need-authgroup && " $* " != *" --authgroup="* ]]; then
  echo "2 gateway servers available:"
  echo "  BACKUP-EXAMPLE (backup.example.com) [priority 2]"
  echo "  PROD-EXAMPLE (vpn.example.com) [priority 1]"
  echo "GATEWAY: [BACKUP-EXAMPLE|PROD-EXAMPLE]:***" >&2
  echo "User input required in non-interactive mode" >&2
  echo "Failed to complete authentication" >&2
  exit 1
fi
if [[ $mode == hang ]]; then
  sleep 30
  exit 0
fi
sleep "${FAKE_OC_DELAY:-0}"
if [[ ${FAKE_OC_LEAK:-} == 1 ]]; then
  echo "debug AAAAfakeCookieValue0123456789abcdef====="
fi
# Read from any /dev/fd/N paths in argv (TOCTOU-safe fd approach)
for arg in "$@"; do
  if [[ "$arg" =~ ^/dev/fd/[0-9]+$ ]]; then
    if cat "$arg" > "$dir/fd_verify" 2>/dev/null; then
      break
    fi
  fi
done
echo "Connected to HTTPS on vpn.example.com with ciphersuite (TLS1.3)-(ECDHE-SECP256R1)-(RSA-PSS-RSAE-SHA256)-(AES-256-GCM)"
echo "2 gateway servers available:"
echo "  BACKUP-EXAMPLE (backup.example.com) [priority 2]"
echo "  PROD-EXAMPLE (vpn.example.com) [priority 1]"
echo "Gateway says no HIP report submission is needed."
echo "Configured as 172.16.8.8, with SSL connected and ESP in progress"
echo "Session authentication will expire at Tue, 01 Jan 2030 00:00:00 UTC"
if [[ $mode == exit-after ]]; then
  exit 0
fi
sleep "${FAKE_OC_SLEEP:-60}"
